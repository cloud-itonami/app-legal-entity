{;; lg-legal-entity — clj-native port of the Python LangGraph server (ADR-2606280030).
 ;; Scoped to this app only (does NOT touch the repo-root bb.edn).
 ;;
 ;;   src   — lg-legal-entity.* namespaces (graphs + server)
 ;;   test  — lg-legal-entity.smoke-test (clojure.test)
 ;;
 ;; Run the suite:  bb test   (or:  bb run_tests.clj)
 :paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test {:doc "Run the clojure.test suite under bb."
        :task (load-file "run_tests.clj")}}}
